# E-puck 차동구동 물리를 유지하면서 상부에 Raspbot형 직사각 차체·카메라를 시각적으로 표시한다.
DEF LABKEEPER_ROBOT E-puck {
  translation -1.55 -1.3 0
  rotation 0 0 1 0
  name "LabKeeper Raspbot visual proxy"
  controller "labkeeper_controller"
  supervisor TRUE
  turretSlot [
    GPS { name "gps" }
    GPS { translation 0.05 0 0 name "gps_front" }
    Transform {
      translation 0 0 0.055
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.04 0.35 0.62 roughness 0.35 metalness 0.12 }
          geometry Box { size 0.13 0.105 0.035 }
        }
      ]
    }
    Transform {
      translation 0.055 0 0.105
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.03 0.04 0.05 roughness 0.25 }
          geometry Box { size 0.035 0.055 0.035 }
        }
        Transform {
          translation 0.02 0 0
          rotation 0 1 0 1.5708
          children [ Shape { appearance PBRAppearance { baseColor 0.08 0.1 0.12 metalness 0.2 } geometry Cylinder { height 0.018 radius 0.012 } } ]
        }
      ]
    }
  ]
}
