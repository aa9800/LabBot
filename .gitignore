# Python
__pycache__/
*.pyc
*.pyo

# 문서 검토용 렌더링 잔여물 (PDF -> PNG 변환 중간 산출물, 소스가 아님)
docs/_qa_*/

# 웹(web/) — 지훈님 코드. 비밀키/의존성 폴더는 절대 커밋하지 않음
web/node_modules/
web/.env
web/.env.local
web/.env.*.local
web/dist/
web/build/
web/*.db

# 정적 사이트라 빌드 도구 없이 Supabase 접속 정보를 여기서 관리 (config.example.js가 템플릿)
web/js/config.js

# robot-sim — Supabase secret key(로봇 전용, 절대 커밋 금지)
robot-sim/.env
robot-sim/logs/*.jsonl

# Webots — 창 배치/썸네일 같은 개인 UI 상태 파일 (프로젝트 소스 아님)
# _archive_pygame_webots/로 보관된 경로에도 동일하게 적용(2026-08-27 구조 정리)
robot-sim/webots_project/worlds/.*.wbproj
robot-sim/webots_project/worlds/.*.jpg
robot-sim/_archive_pygame_webots/webots_project/worlds/.*.wbproj
robot-sim/_archive_pygame_webots/webots_project/worlds/.*.jpg

# OS/에디터
.DS_Store
Thumbs.db
.vscode/

# 중계기 커서 — 로컬 상태라 커밋하지 않는다
robot-sim/relay_cursor.json

# ── AI 비전(YOLO) 학습 산출물 ─────────────────────────────────────
# 코덱스가 만드는 ai_vision/ 의 "코드"는 커밋한다. 하지만 모델 가중치와 학습
# 산출물은 용량이 커서(합계 약 46MB) 한 번 올라가면 git 히스토리에서 못 지운다.
# 가중치는 다시 내려받거나 재학습으로 얻을 수 있으므로 제외한다.
# (주의: .gitignore는 같은 줄 뒤 주석을 지원하지 않는다 — 반드시 줄을 나눌 것)

# 모델 가중치 (yolo11n.pt, best.pt, last.pt 등)
*.pt
# 학습 실행 결과 (그래프·체크포인트)
runs/
# 내려받은 베이스 모델
weights/
# 학습 데이터셋
datasets/
robot-sim/datasets/
# 학습 결과물 (곡선 png, csv, 가중치)
robot-sim/ai_vision/models/
# 실행 중 갱신되는 임시 스냅샷
robot-sim/ai_vision/latest_ai_snapshot.jpg

# 실행 중 생성되는 캡처 이미지 (소스 아님)
robot-sim/cam_h_*.jpg
robot-sim/live_isaac_fpv.jpg
robot-sim/test_render_view.jpg
robot-sim/isaac_project/lab_scene_*.png
test_wh.jpg

# NCNN 변환 산출물 — 가중치에서 언제든 다시 만들 수 있다
# (주의: 이 파일은 패턴 줄 끝의 주석을 지원하지 않는다. 주석은 반드시 별도 줄에)
yolo11n_ncnn_model/

# Roboflow 데이터셋 후보 조회 결과 — 조회할 때마다 달라지는 임시 파일
robot-sim/rf_candidates.json
